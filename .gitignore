# ------------------------------------------------------------------
# 1. Operating System and Editor Files (Common to most projects)
# ------------------------------------------------------------------
.DS_Store       # Mac OS metadata file
Thumbs.db       # Windows thumbnail cache

# ------------------------------------------------------------------
# 2. Python / Virtual Environment (Common for Airflow/dbt CLI)
# ------------------------------------------------------------------
__pycache__/    # Python compiled byte code
*.pyc           # Compiled python files
.venv/          # Virtual environment folders
venv/
env/
.env            # Environment variables file

# ------------------------------------------------------------------
# 3. dbt (Data Build Tool) Specific
# ------------------------------------------------------------------
# Always ignore the target folder where dbt compiles SQL and stores logs
dbt_project/target/
dbt_project/logs/
dbt_project/dbt_packages/ # dbt dependencies installed from packages.yml

# Personal profiles should NOT be committed as they contain credentials
dbt_project/profiles.yml
# Also ignore the global file if you're working locally
~/.dbt/profiles.yml

# ------------------------------------------------------------------
# 4. Airflow / Docker Specific
# ------------------------------------------------------------------
# Logs generated by Airflow and webserver process
airflow/logs/
# Airflow's local database file (if using SQLite)
airflow/airflow.db
# Files generated by Docker (if used for local development)
*.swp
.idea/